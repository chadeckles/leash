# Only include what's needed for the source distribution
include LICENSE
include README.md
include pyproject.toml
include requirements.txt
recursive-include app *.py *.yaml *.html *.png
recursive-include sdk *.py
include assets/leash_icon.png

# Exclude everything else
prune tests
prune docs
prune scripts
prune .github
exclude STRATEGY.md
exclude DEMO.md
exclude SECURITY.md
exclude CONTRIBUTING.md
exclude CHANGELOG.md
exclude Makefile
exclude Dockerfile
exclude docker-compose.yml
exclude leash
